# Vite inlines every VITE_* var into the client bundle at build time.
# Only put values here that are safe to be public. Never a service_role key.

# Point these at the monorepo's own Railway services. They fall back to the old
# standalone deployments, so they must be set before those are shut down.
VITE_PAYMENTS_API_URL=
VITE_GEOQUEST_URL=

# Same Supabase project GeoQuest uses. Anon key only — the homepage reads through
# homepage_stats() and public_leaderboard, which expose no PII.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
